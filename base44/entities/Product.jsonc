{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "name_en": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e6\u05e8 \u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "description_en": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05de\u05d5\u05e6\u05e8 \u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea"
    },
    "price": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "category": {
      "type": "string",
      "enum": [
        "rings",
        "necklaces",
        "earrings",
        "bracelets",
        "collections"
      ],
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05ea \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "sub_category": {
      "type": "string",
      "description": "\u05ea\u05ea \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 (\u05dc\u05de\u05e9\u05dc, '\u05d8\u05d1\u05e2\u05d5\u05ea \u05d0\u05d9\u05e8\u05d5\u05e1\u05d9\u05df')"
    },
    "sub_category_en": {
      "type": "string",
      "description": "\u05ea\u05ea \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05e2\u05e8\u05da \u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05d5\u05e6\u05e8 \u05de\u05d5\u05de\u05dc\u05e5"
    },
    "stock_quantity": {
      "type": "number",
      "default": 100,
      "description": "\u05db\u05de\u05d5\u05ea \u05d1\u05de\u05dc\u05d0\u05d9"
    },
    "metal_type": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05ea\u05db\u05ea"
    },
    "metal_type_en": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05ea\u05db\u05ea \u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea"
    },
    "gemstone": {
      "type": "string",
      "description": "\u05d0\u05d1\u05df \u05d7\u05df"
    },
    "gemstone_en": {
      "type": "string",
      "description": "\u05d0\u05d1\u05df \u05d7\u05df \u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea"
    },
    "size_options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea \u05de\u05d9\u05d3\u05d5\u05ea"
    },
    "available_sizes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05d9\u05d3\u05d5\u05ea \u05d6\u05de\u05d9\u05e0\u05d5\u05ea \u05d1\u05de\u05dc\u05d0\u05d9"
    }
  },
  "required": [
    "name",
    "price",
    "category"
  ],
  "access": {
    "list": true,
    "get": true,
    "create": "user.role == 'admin'",
    "update": "user.role == 'admin'",
    "delete": "user.role == 'admin'"
  },
  "rls": {
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}