{
  "name": "CartItem",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "\u05db\u05de\u05d5\u05ea"
    },
    "size": {
      "type": "string",
      "description": "\u05de\u05d9\u05d3\u05d4 \u05e0\u05d1\u05d7\u05e8\u05ea"
    },
    "gold_plating": {
      "type": "boolean",
      "default": false,
      "description": "\u05e6\u05d9\u05e4\u05d5\u05d9 \u05d6\u05d4\u05d1"
    },
    "user_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    }
  },
  "required": [
    "product_id",
    "user_email"
  ],
  "access": {
    "list": "record.user_email == user.email",
    "get": "record.user_email == user.email",
    "create": "user.id != null",
    "update": "record.user_email == user.email",
    "delete": "record.user_email == user.email"
  },
  "rls": {
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "write": {
      "data.user_email": "{{user.email}}"
    }
  }
}