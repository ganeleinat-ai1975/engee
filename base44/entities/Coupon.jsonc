{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05d4\u05e7\u05d5\u05e4\u05d5\u05df (\u05dc\u05d3\u05d5\u05d2\u05de\u05d4, SALE10)"
    },
    "type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d4\u05e0\u05d7\u05d4: \u05d0\u05d7\u05d5\u05d6 \u05d0\u05d5 \u05e1\u05db\u05d5\u05dd \u05e7\u05d1\u05d5\u05e2"
    },
    "value": {
      "type": "number",
      "description": "\u05e2\u05e8\u05da \u05d4\u05d4\u05e0\u05d7\u05d4 (\u05dc\u05de\u05e9\u05dc, 10 \u05e2\u05d1\u05d5\u05e8 10% \u05d0\u05d5 50 \u05e2\u05d1\u05d5\u05e8 50 \u05e9\"\u05d7)"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05e4\u05e0\u05d9\u05de\u05d9 \u05e9\u05dc \u05d4\u05e7\u05d5\u05e4\u05d5\u05df (\u05dc\u05de\u05e9\u05dc, '\u05d4\u05e0\u05d7\u05ea \u05d7\u05d2')"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d7\u05dc\u05ea \u05ea\u05d5\u05e7\u05e3 \u05d4\u05e7\u05d5\u05e4\u05d5\u05df"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd \u05ea\u05d5\u05e7\u05e3 \u05d4\u05e7\u05d5\u05e4\u05d5\u05df"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e7\u05d5\u05e4\u05d5\u05df \u05e4\u05e2\u05d9\u05dc"
    }
  },
  "required": [
    "code",
    "type",
    "value"
  ],
  "access": {
    "list": true,
    "get": true,
    "create": "user.role == 'admin'",
    "update": "user.role == 'admin'",
    "delete": "user.role == 'admin'"
  },
  "rls": {
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}