{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05de\u05dc\u05d9\u05e5/\u05d4"
    },
    "name_en": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05de\u05dc\u05d9\u05e5/\u05d4 \u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea"
    },
    "text": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05d4\u05de\u05dc\u05e6\u05d4"
    },
    "text_en": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05d4\u05de\u05dc\u05e6\u05d4 \u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 5,
      "description": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05db\u05d5\u05db\u05d1\u05d9\u05dd (1-5)"
    },
    "location": {
      "type": "string",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05dc\u05e7\u05d5\u05d7 (\u05e2\u05d9\u05e8)"
    },
    "location_en": {
      "type": "string",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05dc\u05e7\u05d5\u05d7 \u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d4\u05de\u05dc\u05e6\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4"
    }
  },
  "required": [
    "name",
    "text"
  ],
  "access": {
    "list": true,
    "get": true,
    "create": "user.role == 'admin'",
    "update": "user.role == 'admin'",
    "delete": "user.role == 'admin'"
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}